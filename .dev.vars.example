# Copy this file to .dev.vars and fill in your values.
# .dev.vars is loaded automatically by `wrangler pages dev`

# --- BuildBase Auth (server-side only) ---------------------------------------
# Find these in your BuildBase dashboard -> Settings -> OAuth
SAAS_SERVER_URL=https://api.console.buildbase.app
SAAS_ORG_ID=your_org_id
SAAS_CLIENT_ID=your_client_id
SAAS_CLIENT_SECRET=your_client_secret
# Found in BuildBase dashboard -> Settings -> API Tokens (used to verify incoming events)
SAAS_API_TOKEN_SECRET=your_org_id:your_api_token

# --- Client (public) ---------------------------------------------------------
NEXT_PUBLIC_SAAS_SERVER_URL=https://api.console.buildbase.app
NEXT_PUBLIC_SAAS_ORG_ID=your_org_id
NEXT_PUBLIC_SAAS_CLIENT_ID=your_client_id
NEXT_PUBLIC_PLAN_GROUP_SLUG=main
NEXT_PUBLIC_APP_URL=https://agentcenter.cloud/dashboard

# --- JWT signing -------------------------------------------------------------
# Generate with: openssl rand -base64 32
SYSTEM_SECRET=your_32_char_random_secret_here

# --- Lifetime deal (admin webhook protection) --------------------------------
# Any random secret to protect the lifetime-deal webhook endpoint
LIFETIME_DEAL_TOKEN=your_random_token_here

# --- SEO verification (optional) ---------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=
