# Copy this file to .env.local and fill in your values.
# .env.local is loaded automatically by Next.js for local development.

# --- BuildBase Auth (server-side only) ---------------------------------------
# Find these in your BuildBase dashboard -> Settings -> OAuth
SAAS_SERVER_URL=https://api.console.buildbase.app
SAAS_ORG_ID=your_org_id
SAAS_CLIENT_ID=your_client_id
SAAS_CLIENT_SECRET=your_client_secret

# --- Client (public) ---------------------------------------------------------
NEXT_PUBLIC_SAAS_SERVER_URL=https://api.console.buildbase.app
NEXT_PUBLIC_SAAS_ORG_ID=your_org_id
NEXT_PUBLIC_SAAS_CLIENT_ID=your_client_id
NEXT_PUBLIC_PLAN_GROUP_SLUG=main
NEXT_PUBLIC_APP_URL=https://agentcenter.cloud/dashboard

# --- JWT signing -------------------------------------------------------------
# Generate with: openssl rand -base64 32
SYSTEM_SECRET=your_32_char_random_secret_here

# --- Infra API (server-side only) --------------------------------------------
# URL of the MissionControlSquad-infra dashboard (e.g. https://admin.agentcenter.cloud)
INFRA_API_URL=https://admin.agentcenter.cloud
# Must match API_KEY in the infra .env.local
INFRA_API_KEY=your_infra_api_key_here

# --- SEO verification (optional) ---------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
NEXT_PUBLIC_BAIDU_SITE_VERIFICATION=

# ─── Cross-subdomain SSO ──────────────────────────────────────────────────────
# Set to the parent domain (leading dot) in production so the bb-session-id cookie is shared with the
# provisioned tenant dashboards at <client>.app.agentcenter.cloud — users land in their dashboard already
# signed in (no second login). Leave UNSET in local dev and for self-hosted (cookie stays host-only).
# The monorepo tenant dashboard must set the same AUTH_COOKIE_DOMAIN for its mc_session cookie.
AUTH_COOKIE_DOMAIN=.agentcenter.cloud
